# Copy to .env.local for local development, and set the same values in your
# hosting provider's environment settings for production.

# Public address of the live site (no trailing slash). Used for canonical URLs,
# the sitemap and social previews.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.in

# Enquiry form email — https://resend.com
# 1. Create a Resend account and an API key (Sending access is enough).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# 2. Where enquiries are delivered. Comma-separate several addresses.
CONTACT_TO_EMAIL=you@example.com
# 3. Sender. Must be on a domain you've verified in Resend
#    (Resend's onboarding@resend.dev only delivers to your own Resend login email).
CONTACT_FROM_EMAIL="Mani Mohan Construction <enquiries@your-domain.in>"
